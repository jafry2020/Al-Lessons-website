# -----------------------------------------------------------------------------
# Synapse environment variables
# Copy to .env.local for local dev. Do NOT commit .env.local.
# -----------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Neon Postgres connection string. From the Neon dashboard:
#   neon.tech → your project → "Connection Details" → copy the "Pooled" string.
# Looks like: postgresql://user:pass@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Auth.js ------------------------------------------------------------------
# Random 32+ char string. Generate with: openssl rand -base64 33
# (Or just paste any long random string.)
AUTH_SECRET=

# Trust the host header in dev — required for Auth.js in local dev with
# Next.js. In production this is auto-detected from VERCEL_URL.
AUTH_TRUST_HOST=true

# --- GitHub OAuth -------------------------------------------------------------
# From https://github.com/settings/developers → "New OAuth App":
#   Application name:  Synapse (dev)
#   Homepage URL:      http://localhost:3000
#   Authorization callback URL:
#     http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
