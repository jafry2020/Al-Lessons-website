// Synapse — Postgres schema
// Auth.js v5 reference tables (User, Account, Session, VerificationToken)
// + domain tables (Enrollment, LessonProgress, QuizAttempt, Certificate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js core tables — keep field names exactly as the adapter expects.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  certificates    Certificate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain tables
// ---------------------------------------------------------------------------

/// A learner's enrollment in a track. One row per (user, track).
model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  track     String   // e.g. "ml-engineer" — matches frontmatter
  startedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track])
  @@index([userId])
}

/// One row per (user, lesson). Created on first interaction, completedAt
/// is set when the learner clicks "Mark complete".
model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  track       String    // matches frontmatter.track
  module      String    // matches frontmatter.module
  lesson      String    // matches frontmatter.lesson
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  // Convenience denormalization for the dashboard "continue learning" card.
  lastVisitedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track, module, lesson])
  @@index([userId, completedAt])
  @@index([userId, lastVisitedAt])
}

/// Each quiz attempt by a learner. Identifying a quiz needs the lesson
/// triple + a stable `quizId` set on the <InlineQuiz/> shortcode (TODO Phase 2).
/// For MVP we just store one attempt per (user, lesson, quizSlot).
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  track     String
  module    String
  lesson    String
  quizSlot  String   // e.g. "quick-check" — defaults if MDX doesn't name it
  correct   Boolean
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, track, module, lesson])
}

/// Certificates issued on track completion.
model Certificate {
  id          String   @id @default(cuid())
  userId      String
  track       String
  issuedAt    DateTime @default(now())
  pdfUrl      String?  // R2 URL — filled by the cert-issuance job (Phase 1F)
  shareSlug   String   @unique // public, unguessable

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track])
  @@index([userId])
}
